# ============================================================
# AutoLabel-AI Pro · API Key 配置示例
# 复制本文件为 .env，并填入你自己的 Key
# 命令：cp .env.example .env
# ============================================================

# 智谱 AI（主厂商） https://bigmodel.cn/usercenter/glm-api-key
# 完整格式：{key_id}.{key_secret}
ZHIPUAI_API_KEY=你的智谱key.含点分两段

# 阿里云 DashScope（Qwen-VL，备厂商） https://dashscope.aliyun.com
DASHSCOPE_API_KEY=sk-你的阿里key

# 本地 Ollama（可选，备用）http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llava

# InternVL 自部署服务（可选，需 GPU + vLLM）
# INTERNVL_BASE_URL=http://localhost:8000/v1
# INTERNVL_MODEL=internvl2
