*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ===== 虚拟环境 =====
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
conda-env/

# ===== IDE =====
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

